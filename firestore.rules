rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isClassTeacher(classId) {
      return isAuthenticated() && classData(classId).teacherId == request.auth.uid;
    }

    function isClassMember(classId) {
      return isAuthenticated() && (
        request.auth.uid in classData(classId).studentUids ||
        request.auth.token.email.lower() in classData(classId).studentEmails
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isTeacher());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    // Classes
    match /classes/{classId} {
      allow read: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        request.auth.uid in resource.data.studentUids ||
        request.auth.token.email.lower() in resource.data.studentEmails ||
        resource.data.pendingStudents.status == "pending" // Simplified check for pending
      );
      // Students can update classes to join (pendingStudents array)
      allow update: if isAuthenticated() && (
        resource.data.teacherId == request.auth.uid ||
        (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingStudents', 'studentUids']))
      );
      allow create: if isTeacher();
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // Assignments
    match /assignments/{assignmentId} {
      // Reads are open to any authenticated user. The client loads all of a
      // class's/assignment's documents in one unfiltered query and filters per
      // user in the UI (anonymity is a UI concern, not a DB one). Gating reads
      // with get() broke those list queries: a single document with a missing or
      // legacy classId makes the get() error, which denies the entire query.
      allow read: if isAuthenticated();
      allow create: if isTeacher();
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId == request.auth.uid
      );
      allow delete: if isAuthenticated() && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId == request.auth.uid;
    }

    // Submissions (includes teacher-provided texts and student reviewer profiles)
    match /submissions/{submissionId} {
      // Reads are open to any authenticated user; the client queries by
      // assignmentId and filters per user in the UI. A get()-based read rule
      // breaks the list query if any single document has a missing/legacy
      // classId (the get() errors and denies the whole query).
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        // Teacher creates anything (texts) within their class
        isClassTeacher(request.resource.data.classId) ||
        // Enrolled students create their own doc (work submission or reviewer profile)
        (request.resource.data.studentId == request.auth.uid && isClassMember(request.resource.data.classId))
      );
      allow update: if isAuthenticated() && (
        isClassTeacher(resource.data.classId) ||
        resource.data.studentId == request.auth.uid ||
        // Student reviewers update a teacher text's counters when picking up a review
        (resource.data.isTeacherText == true && isClassMember(resource.data.classId))
      );
      allow delete: if isClassTeacher(resource.data.classId);
    }

    // Reviews
    match /reviews/{reviewId} {
      // Reads are open to any authenticated user; the client filters per user in
      // the UI (anonymity is enforced in the UI, not the DB). Same reasoning as
      // submissions: a get()-based read rule breaks the list query.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Logic handled in app
      allow update: if isAuthenticated() && (
        resource.data.reviewerId == request.auth.uid ||
        resource.data.authorId == request.auth.uid || // For meta-reviews
        isClassTeacher(resource.data.classId) ||
        // Teacher-text owners can leave agreement/meta-review feedback
        request.auth.token.email.lower() in get(/databases/$(database)/documents/submissions/$(resource.data.submissionId)).data.get('ownerEmails', [])
      );
      allow delete: if isClassTeacher(resource.data.classId);
    }
  }
}
